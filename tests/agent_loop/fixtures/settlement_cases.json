  "cases": [
    {"name": "success", "overrides": {}, "expected": {"action": "MERGE_DELETE", "reason": "all_gates_pass"}},
    {"name": "failure", "overrides": {"workflow_conclusion": "failure"}, "expected": {"action": "CLOSE_DELETE", "reason": "failure"}},
    {"name": "cancelled", "overrides": {"workflow_conclusion": "cancelled"}, "expected": {"action": "CLOSE_DELETE", "reason": "cancelled"}},
    {"name": "timed_out", "overrides": {"workflow_conclusion": "timed_out"}, "expected": {"action": "CLOSE_DELETE", "reason": "timed_out"}},
    {"name": "action_required", "overrides": {"workflow_conclusion": "action_required"}, "expected": {"action": "CLOSE_DELETE", "reason": "action_required"}},
    {"name": "conflict", "overrides": {"mergeable": false}, "expected": {"action": "CLOSE_DELETE", "reason": "conflict"}},
    {"name": "draft", "overrides": {"non_draft": false}, "expected": {"action": "CLOSE_DELETE", "reason": "draft"}},
    {"name": "fork", "overrides": {"same_repo": false}, "expected": {"action": "CLOSE_ONLY", "reason": "fork", "delete_branch": false}},
    {"name": "unauthorized", "overrides": {"authorized_actor": false}, "expected": {"action": "CLOSE_ONLY", "reason": "unauthorized_actor", "delete_branch": false}},
    {"name": "stale_head", "overrides": {"head_exact": false}, "expected": {"action": "CLOSE_ONLY", "reason": "stale_head", "delete_branch": false}},
    {"name": "stale_tested_base", "overrides": {"tested_base_exact": false}, "expected": {"action": "CLOSE_DELETE", "reason": "stale_tested_base"}},
