    {"name": "duplicate_event", "overrides": {"duplicate_event": true}, "expected": {"action": "NOOP", "reason": "duplicate_event"}},
    {"name": "orphan", "overrides": {"orphan": true, "pr_state": "missing"}, "expected": {"action": "DELETE_ORPHAN", "reason": "trusted_orphan"}},
    {"name": "accidental_issue", "overrides": {"issue_open": true}, "expected": {"action": "MERGE_DELETE", "reason": "all_gates_pass", "close_issue": true}},
    {"name": "required_check_failure", "overrides": {"required_checks_pass": false}, "expected": {"action": "CLOSE_DELETE", "reason": "required_check_failure"}}
