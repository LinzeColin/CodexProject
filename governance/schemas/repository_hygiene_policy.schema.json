{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexProject Repository Hygiene Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "owner",
    "baseline_tree",
    "regular_blob_max_bytes",
    "hard_fail",
    "source_scan",
    "retained_objects",
    "history_rewrite"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "baseline_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "regular_blob_max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "hard_fail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidden_names",
        "forbidden_directory_names",
        "forbidden_suffixes",
        "archive_suffixes"
      ],
      "properties": {
        "forbidden_names": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "forbidden_directory_names": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "forbidden_suffixes": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "archive_suffixes": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "source_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extensions",
        "excluded_paths",
        "excluded_segments",
        "forbidden_regexes"
      ],
      "properties": {
        "extensions": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "excluded_segments": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        },
        "forbidden_regexes": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    },
    "retained_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retainedObject"
      }
    },
    "history_rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_in_this_task",
        "decision",
        "reason",
        "future_preconditions"
      ],
      "properties": {
        "allowed_in_this_task": {
          "type": "boolean",
          "const": false
        },
        "decision": {
          "type": "string",
          "const": "DEFERRED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "future_preconditions": {
          "$ref": "#/$defs/nonemptyUniqueStrings"
        }
      }
    }
  },
  "$defs": {
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retainedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kinds",
        "owner",
        "purpose",
        "consumer",
        "retention",
        "recovery",
        "confidentiality",
        "change_policy",
        "max_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "pattern": "/$"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "large",
              "archive"
            ]
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "confidentiality": {
          "type": "string",
          "minLength": 1
        },
        "change_policy": {
          "type": "string",
          "const": "baseline_oid_only"
        },
        "reviewed_oids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "uniqueItems": true
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "prefix"
            ]
          }
        },
        {
          "required": [
            "prefix"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    }
  }
}
